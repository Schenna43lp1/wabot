# Kopiere diese Datei nach .env und starte den Bot danach neu.

# Wer den Bot benutzen darf: international, nur Ziffern, mit Komma getrennt.
# Dein eigener Chat "Nachricht an dich selbst" funktioniert immer.
ALLOWED_NUMBERS=

# Wie oft die Preise geprüft werden (Minuten, mindestens 15)
CHECK_INTERVAL_MINUTES=180

# Ohne Zielpreis: ab welcher Senkung in Prozent gemeldet wird
MIN_DROP_PERCENT=1

# Auch Preiserhöhungen melden? (true/false)
NOTIFY_INCREASE=false

# Währung, falls ein Shop keine angibt
DEFAULT_CURRENCY=EUR

MAX_PRODUCTS_PER_USER=50
DATA_DIR=data

# Zeitzone für Erinnerungen und Briefing (sonst die des PCs, in Docker Europe/Berlin)
# TZ=Europe/Berlin

# Sprachnachrichten (nach "npm run sprache"): aus = abgeschaltet. In Docker baut "an" sie ins Image.
# SPEECH=an
# Whisper-Modell: tiny, base (Standard), small, turbo oder ein Name von Hugging Face (README, "Modell wählen")
# SPEECH_MODEL=base
